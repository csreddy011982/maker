bls-file-feed:
  acon:
    template-file-name:  adv/ACON_spl_rpt_feed_template.ftl
    schedule: "*/2 * * * * *"
  advice:
    template-file-name:  adv/Advice_feed_template.ftl
    feed-names: ARH,BTR,BTS
    schedule: "*/2 * * * * *"
    out-file-name: output.dat
    remote-file-location: /remote/path/
    out-file-location: output/
  input-data:
    account-file-path: /mockdata/account.dat
    baiCode-file-path: /mockdata/baicodes.dat
    aba-file-path:  /mockdata/aba.dat
  out-data:
    out-file-path: /output
  system-environment:
    host: "sftp.example.com"
    user: "sftp-user"
    key: "sftp-private-key"
  spl-adeel:
     template-file-name: spl/AdeelTemplate.ftl
     feed-names: ADELL
     schedule: "*/2 * * * * *"
     account-file-path: /mockdata/account.dat
     baiCode-file-path: /mockdata/baicodes.dat
     companyName-file-path: /mockdata/company.dat
     out-file-path: /output/
     remote-file-location: /remote/path/
  spl-acon:
    template-file-name: spl/AconTemplate.ftl
    feed-names: ACON
    schedule: "*/2 * * * * *"
    account-file-path: /mockdata/account.dat
    baiCode-file-path: /mockdata/baicodes.dat
    companyName-file-path: /mockdata/company.dat
    out-file-path: /output/
    remote-file-location: /remote/path/
  adell-report:
     template-file-name: adell/adellTemplate.ftl
     feed-names: ADELL,CHAN
     schedule: "*/3 * * * * *"  # Runs every day at 12:00 PM (Cron Expression)
     account-file-path: /mockdata/account.dat
     baiCode-file-path: /mockdata/baicodes.dat
     companyName-file-path: /mockdata/company.dat
     out-file-path: src/main/resources/output
     remote-file-location: /remote/path/
file:
  output-dir: /output/